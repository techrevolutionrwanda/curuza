# Absolute URL of the Express backend (no trailing slash).
#
# Browser requests use relative /api/... URLs and are proxied through the
# Next.js rewrite in next.config.ts, so the session cookie stays on the
# frontend origin. This value is used by that rewrite and by server components.
#
# Production (Vercel → Render): set this in the Vercel project dashboard.
API_URL=https://curuza-nub1.onrender.com

# Optional legacy fallback used when API_URL is not set.
# NEXT_PUBLIC_API_URL=https://curuza-nub1.onrender.com

# For local development, create frontend/.env.local with:
# API_URL=http://localhost:4000
