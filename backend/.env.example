# ── Core ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string used by Render.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/curuza
SESSION_SECRET=replace-with-a-long-random-secret
PORT=4000
NODE_ENV=production

# ── Frontend / CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Production example: https://curuza.vercel.app
# Local example: http://localhost:3000
FRONTEND_URL=https://curuza.vercel.app

# Cross-site cookies are required when the Vercel frontend and Render
# backend use different domains. This is the default in production.
# Use "lax" only when the frontend and API share a parent domain.
COOKIE_SAME_SITE=none
# Must be true when COOKIE_SAME_SITE=none.
COOKIE_SECURE=true

# Optional: allow Vercel preview deployments without listing each URL.
# Example: ^https://curuza-[a-z0-9-]+\.vercel\.app$
# VERCEL_PREVIEW_ORIGIN_PATTERN=

# ── Password-reset email (optional) ──────────────────────────────────
# Without SMTP the backend logs reset links instead of emailing them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Curuza <no-reply@curuza.local>

# ── SMS Connect Rwanda ───────────────────────────────────────────────
SMS_CONNECT_BASE_URL=https://smsconnect.tech/api/v1
SMS_CONNECT_API_KEY=
SMS_CONNECT_API_SECRET=
SMS_CONNECT_SENDER_ID=CURUZA
SMS_DRY_MODE=true
SMS_UNIT_COST_RWF=10
# Run the reminder worker inside the API process (default) or separately.
SMS_WORKER_INLINE=true
